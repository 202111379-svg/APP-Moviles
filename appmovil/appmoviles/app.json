{
  "expo": {
    "name": "appmoviles",
    "slug": "app-moviles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appmoviles",
    "userInterfaceStyle": "automatic",

    "newArchEnabled": false,

    "android": {
      "package": "com.viduoso2002.appmoviles",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },

    "ios": {
      "supportsTablet": true
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "063ee339-2598-4dcf-b2c9-a857cb7fabde"
      }
    }
  }
}
